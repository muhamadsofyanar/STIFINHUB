NODE_ENV=production
PORT=3000
APP_NAME=STIFIn Mulia Marketing Hub
APP_URL=https://app.stifinmulia.com
BUSINESS_WHATSAPP=081333362649
APP_KEY=ganti-dengan-rangkaian-acak-minimal-32-karakter
APP_ADMIN_EMAIL=admin@stifinmulia.com
APP_ADMIN_PASSWORD=ganti-password-kuat-minimal-10-karakter
COOKIE_SECURE=true
DATA_FILE=/app/data/database.json
BACKUP_DIR=/app/data/backups
BACKUP_INTERVAL_MINUTES=360
BACKUP_RETENTION=30
TZ=Asia/Jakarta

# API STIFIn — data cabang JML-CAB-62
STIFIN_API_BASE=https://apro.stifin.id/api
STIFIN_BRANCH_CODE=JML-CAB-62
STIFIN_API_AUTH_HEADER=
STIFIN_API_AUTH_VALUE=
INTEGRATION_TIMEOUT_MS=15000

# StarSender V3 — isi langsung di Coolify, jangan simpan ke Git
STARSENDER_ENABLED=false
STARSENDER_SEND_URL=https://api.starsender.online/api/send
STARSENDER_GROUPS_URL=https://api.starsender.online/api/whatsapp/groups
STARSENDER_GROUP_SEND_URL=https://api.starsender.online/api/send/grup
STARSENDER_API_KEY=
STARSENDER_AUTH_HEADER=Authorization
STARSENDER_AUTH_SCHEME=
STARSENDER_WEBHOOK_SECRET=ganti-dengan-token-acak
